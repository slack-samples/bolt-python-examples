{
  "display_information": {
    "name": "Acme",
    "description": "Rocket skates, anvils, and giant magnets for every plan"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true
    },
    "bot_user": {
      "display_name": "Acme",
      "always_online": true
    },
    "user_connections": {
      "is_enabled": true,
      "auth_hosts": ["example.com"]
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "user_connection",
        "user_connection_status_requested"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
